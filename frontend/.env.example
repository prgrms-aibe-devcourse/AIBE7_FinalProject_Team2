# 이 파일을 복사해 .env.local로 쓴다 (.env.local은 커밋하지 않는다)

# API 기본 경로. 개발 서버는 /api 요청을 백엔드(localhost:8080)로 프록시하므로 보통 그대로 둔다.
VITE_API_BASE_URL=/api/v1
# 다른 도메인의 API 주소를 쓰면 익명 ID 쿠키(SameSite=Lax)가 전달되지 않을 수 있다.
# 프론트와 API는 같은 도메인으로 배포하는 것이 기본이다 (docs/tech-stack.md 8장).

# 화면이 쓰는 API 종류
#   mock (기본): HTTP 요청 없이 목 데이터로 동작. 백엔드 없이 화면 확인
#   real       : 실제 백엔드로 요청 (백엔드 실행 후 사용)
VITE_API_MODE=mock
