# 운영 환경변수 예시 (BE-58). 이 파일을 deploy/.env로 복사해 값을 채운다.
# deploy/.env는 .gitignore에 들어 있어 커밋되지 않는다. 실제 값은 절대 이 예시 파일에 적지 않는다.

# ---------- 이미지 ----------
# GHCR 이미지 이름 앞부분. 서버에서는 Actions가 올린 이미지를 받는다 (소문자만 허용)
#   예: ghcr.io/prgrms-aibe-devcourse/lawnambul  (→ lawnambul-web · lawnambul-backend 이미지를 받는다, deploy-images.yml과 같아야 함)
# 로컬에서 docker compose build로 직접 만들 때는 비워 두면 lawnambul-web · lawnambul-backend로 만든다
IMAGE_PREFIX=
# 받을 이미지 태그. Actions는 develop 최신(develop)과 커밋 해시(sha-xxxxxxx)로 올린다
IMAGE_TAG=develop

# ---------- 웹 ----------
# 밖으로 여는 포트. 서버는 80, 로컬에서 80이 이미 쓰이고 있으면 8081 등으로 바꾼다
WEB_PORT=80

# ---------- DB (7.1.2에서 RDS로 바꾸기 전까지 같은 서버의 컨테이너) ----------
POSTGRES_DB=lawnambul
POSTGRES_USER=lawnambul
# 필수. 비어 있으면 docker compose가 실행을 거부한다. 서버에서 길고 무작위인 값으로 만든다 (예: openssl rand -base64 24)
POSTGRES_PASSWORD=

# ---------- 백엔드 ----------
# 관리자 세션 쿠키 Secure. HTTPS 적용 전 http로 관리자 로그인을 확인해야 할 때만 잠깐 false (README "HTTPS 전 제한")
SESSION_COOKIE_SECURE=true
# AI 판결 RAG 유사 판례 검색 키. 없으면 RAG만 꺼진다
GEMINI_API_KEY=
# 첫 관리자 계정. 처음 기동할 때만 넣고, 계정이 만들어지면 지운다
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- 실제 사건 데이터 (서버 전용) ----------
# docker-compose.real-seed.yml을 겹쳐 실행할 때만 쓴다. 서버에 받아 둔 비공개 저장소 seed 폴더의 절대 경로
#   예: /opt/lawnambul/private-seed/seed
REAL_SEED_DIR=
