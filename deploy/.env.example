# 운영 환경변수 예시 (BE-58). 이 파일을 deploy/.env로 복사해 값을 채운다.
# deploy/.env는 .gitignore에 들어 있어 커밋되지 않는다. 실제 값은 절대 이 예시 파일에 적지 않는다.

# ---------- 이미지 ----------
# GHCR 이미지 이름 앞부분. 서버에서는 Actions가 올린 이미지를 받는다 (소문자만 허용)
#   예: ghcr.io/prgrms-aibe-devcourse/lawnambul  (→ lawnambul-web · lawnambul-backend 이미지를 받는다, deploy-images.yml과 같아야 함)
# 로컬에서 docker compose build로 직접 만들 때는 비워 두면 lawnambul-web · lawnambul-backend로 만든다
IMAGE_PREFIX=
# 받을 이미지 태그. Actions는 develop 최신(develop)과 커밋 해시(sha-xxxxxxx)로 올린다
IMAGE_TAG=develop

# ---------- 웹 ----------
# 밖으로 여는 포트. 서버는 80, 로컬에서 80이 이미 쓰이고 있으면 8081 등으로 바꾼다
WEB_PORT=80

# ---------- HTTPS (BE-75, 서버 전용 · 발급 절차는 deploy/README.md "HTTPS") ----------
# https 포트. 로컬에서 443이 이미 쓰이고 있으면 8443 등으로 바꾼다
WEB_HTTPS_PORT=443
# 서비스 도메인 (www 없이, 소문자). 이 값 + 아래 인증서가 있을 때만 https가 켜진다. 비워 두면 http만
#   서버 예: SERVER_DOMAIN=naelawnambul.today
SERVER_DOMAIN=
# 429 전용 로그 크기 상한(바이트, BE-63). 넘으면 1분 안에 비운다. 1보다 작거나 숫자가 아니면 기본값(10MB)을 쓴다
#   서버 예: RATE_LIMIT_LOG_MAX_BYTES=10485760
RATE_LIMIT_LOG_MAX_BYTES=
# 서버 호스트의 certbot 폴더. 비워 두면(CI · 로컬) 빈 볼륨이 붙어 https가 켜지지 않는다
# 인증서는 live · archive 두 폴더만 붙인다(certbot 계정 키가 있는 accounts/는 컨테이너에 넣지 않는다)
#   서버 예: LETSENCRYPT_LIVE_DIR=/etc/letsencrypt/live · LETSENCRYPT_ARCHIVE_DIR=/etc/letsencrypt/archive
#            CERTBOT_WEBROOT=/var/www/certbot
LETSENCRYPT_LIVE_DIR=
LETSENCRYPT_ARCHIVE_DIR=
CERTBOT_WEBROOT=

# ---------- DB (7.1.2에서 RDS로 바꾸기 전까지 같은 서버의 컨테이너) ----------
POSTGRES_DB=lawnambul
POSTGRES_USER=lawnambul
# 필수. 비어 있으면 docker compose가 실행을 거부한다. 서버에서 길고 무작위인 값으로 만든다 (예: openssl rand -base64 24)
POSTGRES_PASSWORD=

# ---------- Redis (BE-61, 캐시 DB 0 · 토큰 저장소 DB 1) ----------
# 필수. 비어 있으면 docker compose가 실행을 거부한다. 서버에서 길고 무작위인 값으로 만든다
# 16진수로 만든다 (예: openssl rand -hex 24) — 값에 `$`가 있으면 Compose가 변수로 읽어 경고만 내고 비밀번호를 잘라 버린다
REDIS_PASSWORD=

# ---------- 백엔드 ----------
# 관리자 세션 쿠키 Secure. HTTPS 적용 전 http로 관리자 로그인을 확인해야 할 때만 잠깐 false (README "HTTPS")
SESSION_COOKIE_SECURE=true
# Gemini 키. RAG 유사 판례 검색 · 사건 사진 프롬프트 추천(BE-89) · 신문 지면 생성(BE-92)이 같은 키를 쓴다.
# 없으면 그 기능들만 꺼지고 서버는 정상으로 뜬다. 아래 파이프라인 서비스(COMMON-50)도 이 값을 함께 받는다
GEMINI_API_KEY=
# 파일 저장소 S3 (COMMON-47). 운영 버킷 이름. 비워 두면 S3를 쓰는 기능만 동작하지 않는다
# 인증은 EC2 IAM 역할로 하므로 AWS 키(AWS_ACCESS_KEY_ID · AWS_SECRET_ACCESS_KEY)는 이 파일에 넣지 않는다
#   서버 예: S3_BUCKET_NAME=<운영 버킷 이름>
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
# 첫 관리자 계정. 처음 기동할 때만 넣고, 계정이 만들어지면 지운다
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# 회원 JWT 서명 키 (확장 단계, BE-94). 필수. 비어 있으면 docker compose가 실행을 거부한다.
# Base64, HS256이라 디코딩 32바이트 이상이어야 한다 (예: openssl rand -base64 32)
JWT_SECRET=
# 액세스 · 리프레시 토큰 유효 기간. 비워 두면 application.yml 기본값(15m · 14d)을 쓴다
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=
# 카카오 로그인 (확장 단계, BE-62). 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키(REST API 키) · 보안(Client Secret, 활성화)
# 비워 두면 카카오 로그인만 꺼진다. ID를 넣으면 SECRET도 필수
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------- 모니터링 에이전트 (COMMON-43, 서버 전용) ----------
# 이 서버에서 Alloy · node_exporter를 함께 돌릴 때만 1로 둔다. 1이면 deploy.sh가 자동 배포에도
# docker-compose.monitoring-agent.yml을 함께 쓴다 — 빼먹으면 backend 재생성 때 로그 볼륨 · 8081이 사라져
# 수집이 조용히 끊긴다. 비워 두면 에이전트를 쓰지 않는 서버로 보고 아무것도 바꾸지 않는다
MONITORING_AGENT=
# 위를 1로 뒀다면 둘 다 필수다(없으면 deploy.sh가 배포를 시작하기 전에 멈춘다).
# 포트는 0.0.0.0이 아니라 이 사설 IP에만 연다 — Docker가 연 포트는 서버 방화벽(ufw)을 우회하기 때문이다
MAIN_PRIVATE_IP=
# 모니터링 호스트(Loki)의 주소. 예: http://10.0.1.23:3100/loki/api/v1/push
LOKI_URL=

# ---------- AI 판결 파이프라인 서비스 (COMMON-50, 서버 전용) ----------
# 관리자 사건 등록(A-14)이 쓰는 내부 컨테이너를 함께 띄울 때만 1로 둔다. 1이면 deploy.sh가 자동 배포에도
# docker-compose.pipeline.yml을 함께 쓴다 — 빼먹으면 backend 재생성 때 PIPELINE_SERVICE_URL이 사라져
# 사건 등록만 조용히 안 된다. 비워 두면 이 컨테이너를 쓰지 않는 서버로 보고 아무것도 바꾸지 않는다
# ⚠️ 켜기 전 메모리를 꼭 확인한다 (t3.small 여유가 적다): deploy/docker-compose.pipeline.yml 머리말
PIPELINE_SERVICE=
# 7.1.2 RDS 전환 전(postgres 컨테이너가 있는 서버)에는 메모리 여유가 약 250MB뿐이라, 위 경고를 확인했다는
# 표시가 없으면 deploy.sh가 배포를 시작하기 전에 멈춘다. docker stats로 확인한 뒤에만 1을 넣는다
# (RDS 전환 뒤에는 postgres 서비스가 없어져 이 검사를 타지 않으므로 이 값도 필요 없다)
PIPELINE_MEMORY_CHECKED=
# 1로 뒀다면 ANTHROPIC_API_KEY · GEMINI_API_KEY · OPENAI_API_KEY 중 **하나 이상** 필수다
# (없으면 deploy.sh가 배포를 시작하기 전에 멈춘다. 모든 단계가 어차피 실패하기 때문)
# 판결문 원문이 나가는 extract · court 단계에는 **유료 등급 키만** 쓴다 — 무료 등급은 입력을 제품 개선에 쓸 수 있다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 아래 둘은 선택. generate 단계에서 그 공급자 모델을 쓸 때만 필요하다 (없으면 그 모델만 실패한다)
GROQ_API_KEY=
NVIDIA_API_KEY=

# ---------- 실제 사건 데이터 (서버 전용) ----------
# docker-compose.real-seed.yml을 겹쳐 실행할 때만 쓴다. 서버에 받아 둔 비공개 저장소 seed 폴더의 절대 경로
#   예: /opt/lawnambul/private-seed/seed
REAL_SEED_DIR=
