// Grafana Alloy — 백엔드 JSON 로그 파일을 읽어 Loki로 보낸다 (BE-71, WBS 7.2.3).
// (BE-63) 웹 429 전용 로그도 같은 규칙으로 보낸다. 로컬 Compose에는 웹이 없어 파일이 없으면 그냥 건너뛴다
// Promtail은 2026-03-02에 EOL(지원 종료)돼서 신규로는 쓰지 않는다. 같은 역할을 Alloy의 구성 요소로 만든다.

local.file_match "backend_logs" {
	// docker-compose.yml이 backend/logs를 이 경로로 읽기 전용 마운트한다
	path_targets = [{"__path__" = "/var/log/backend/*.log", "job" = "backend"}]
}

loki.source.file "backend" {
	targets    = local.file_match.backend_logs.targets
	forward_to = [loki.process.backend.receiver]
}

loki.process "backend" {
	forward_to = [loki.write.default.receiver]

	// JSON 로그에서 level만 꺼내 라벨로 쓴다. level은 DEBUG·INFO·WARN·ERROR 등 값의 종류가 적어서
	// 라벨로 둬도 스트림이 늘어나지 않는다. traceId 같은 요청별 고유값은 절대 라벨로 승격하지 않는다
	// (7.2.1에서 메트릭 라벨에 사건 ID·체험 ID를 금지한 것과 같은 이유 — Loki도 라벨 조합마다 스트림이 하나씩 생긴다)
	stage.json {
		expressions = {level = "level"}
	}
	stage.labels {
		values = {level = "level"}
	}
}

// 웹(Nginx)의 429 전용 로그 (BE-63). Nginx가 막은 요청은 백엔드에 닿지 않아 위 백엔드 로그에 없다.
// default.conf가 status 429만 JSON 한 줄씩 쓴다. route(막힌 경로 묶음: auth_token · admin_login · oauth · api)만 라벨로 올린다 —
// 값이 네 개로 고정이라 스트림이 늘지 않는다. ip · path는 요청마다 달라 라벨로 올리지 않는다(BE-71 카디널리티 규칙)
local.file_match "web_rate_limited" {
	path_targets = [{"__path__" = "/var/log/web/rate-limited.log", "job" = "web"}]
}

loki.source.file "web_rate_limited" {
	targets    = local.file_match.web_rate_limited.targets
	forward_to = [loki.process.web_rate_limited.receiver]
}

loki.process "web_rate_limited" {
	forward_to = [loki.write.default.receiver]

	// 줄 중간부터 읽힌 조각을 버린다. Alloy가 멈춘 사이 웹이 파일을 비우고(41-trim-rate-limit-log.sh) 다시 채우면,
	// 다시 켜진 Alloy가 기억해 둔 위치부터 읽어 앞이 잘린 줄이 들어올 수 있다(PR #236 리뷰 확인 — 그 구간의 줄은 빠진다).
	// 온전한 줄은 항상 "{"로 시작한다
	stage.drop {
		expression          = "^[^{]"
		drop_counter_reason = "partial_line"
	}

	stage.json {
		expressions = {route = "route", time = "time"}
	}

	// Loki 시각을 "Alloy가 읽은 시각"이 아니라 Nginx가 막은 시각으로 둔다(PR #236 리뷰).
	// Alloy가 멈췄던 구간(재시작 · 이미지 교체 · mem_limit OOM)에 쌓인 줄이 복구 시각 한 점에 몰리지 않게 한다.
	// $time_iso8601(예: 2026-10-21T12:00:00+00:00)은 RFC3339 그대로다. 재시도 상한(약 1시간)이 Loki의
	// reject_old_samples_max_age(기본 1주)보다 훨씬 짧아 거부되지 않는다
	stage.timestamp {
		source = "time"
		format = "RFC3339"
	}

	stage.labels {
		values = {route = "route"}
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
