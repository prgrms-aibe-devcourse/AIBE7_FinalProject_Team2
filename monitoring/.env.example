# 모니터링 전용 EC2용 환경변수 (COMMON-43, WBS 7.2.4)
# cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다 (chmod 600).
# 로컬(docker-compose.yml)은 기본값만으로 뜨므로 .env가 없어도 된다 — 이 파일은 운영 구성용이다.

# Grafana 관리자 계정. 기본값이 없어서 비워 두면 컨테이너가 뜨지 않는다 (admin/admin으로 올라가는 사고 방지)
GRAFANA_ADMIN_USER=admin
# openssl rand -base64 24 로 만든 값을 쓴다
GRAFANA_ADMIN_PASSWORD=

# Prometheus 보존 기간 · 용량. 둘 중 먼저 닿는 조건이 적용된다
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB

# 이 EC2의 사설 IP. Loki(3100)를 여기에만 바인딩한다 — 0.0.0.0에 바인딩하지 않는다(D 요청, COMMON-43).
# Docker가 연 포트는 서버 방화벽(ufw)을 우회하고 Loki에는 인증이 없어, 보안 그룹이 유일한 보호선이기 때문이다.
# 값이 없으면 컨테이너가 뜨지 않는다. 인스턴스를 중지했다 켜면 사설 IP가 바뀔 수 있으니 그때 함께 고친다
MONITORING_PRIVATE_IP=
