# 공용 개발 DB (Supabase, COMMON-59) 접속 파일 예시 — backend/SHARED-DEV-DB.md
#
# ⚠️ 이 파일은 커밋된다. 여기에 실제 값을 넣지 않는다 — 반드시 복사한 .env.supabase에 넣는다.
#   cp .env.supabase.example .env.supabase   # 복사한 .env.supabase는 커밋되지 않는다(.gitignore)
#   ./run-shared-db.sh                       # 실행 (팀원) — 담당자 적용은 ./run-shared-db.sh --migrate
#
# 아래 세 값만 바꾼다. 꺾쇠(< >)나 공백을 넣지 않는다 — source할 때 셸 오류가 난다.
# 호스트 · 프로젝트 ref는 Supabase 대시보드 Connect > Session pooler 값 그대로 (포트 5432, 6543 아님)
# 비밀번호는 담당자에게 DM으로 받는다. 대시보드에서 비밀번호를 리셋하지 않는다(모두의 접속이 끊긴다)

DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=CHANGE_ME

# 공용 DB라 연결 수를 작게 둔다 (팀 4명 × 3). 이름은 Spring 공식 환경변수 형식(속성 이름의 하이픈 제거)
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=1

# 마이그레이션은 담당자만 적용한다 — run-shared-db.sh가 --migrate 없이 실행하면 이 값을 false로 고정한다
# (DDL_AUTO는 스크립트가 모든 모드에서 validate로 고정한다 — 여기나 .env.local에 두지 않는다)
SPRING_FLYWAY_ENABLED=false

# 관리자 초기 계정은 담당자만, 처음 한 번만 (--migrate와 함께 쓰고, 만든 뒤 지운다)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
