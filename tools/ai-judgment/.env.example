# tools/ai-judgment API 키 (BE-86). 이 파일을 .env로 복사해 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않는다. 값은 쓰는 공급자만 채우면 된다(전부 필요하지 않다).
# 이미 셸에 설정된 환경변수가 있으면 .env보다 그 값이 우선한다.
# 공급자를 추가하면 llm.py의 API_KEY_ENVS에 맞춰 이 파일도 함께 갱신한다.

# generate · contamination · extract · court에서 OpenAI 모델(openai:모델ID)을 쓸 때
OPENAI_API_KEY=

# extract(비식별화, 기본값) · court에서 Claude 모델을 쓸 때
ANTHROPIC_API_KEY=

# generate · contamination · rag · axis에서 Gemini 모델(gemini:모델ID) · 임베딩을 쓸 때
# (GEMINI_API_KEY와 GOOGLE_API_KEY 중 먼저 설정된 쪽을 쓴다. 보통 둘 중 하나만 채운다)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# generate · contamination에서 Groq 모델(groq:모델ID)을 쓸 때 (BE-84)
GROQ_API_KEY=

# generate · contamination에서 NVIDIA NIM 모델(nim:모델ID)을 쓸 때 (BE-84)
# (NVIDIA_API_KEY와 NVIDIA_NIM_API_KEY 중 먼저 설정된 쪽을 쓴다. 보통 둘 중 하나만 채운다)
NVIDIA_API_KEY=
# NVIDIA_NIM_API_KEY=
